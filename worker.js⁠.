const CLIENT_ID = 'client_01M005QGMRN80T4W3Q6MCFEK14';
const REDIRECT_URI = 'https://garage-agent.gnfcw9w5rk.workers.dev/auth/callback';

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // Standard CORS headers
    const corsHeaders = {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    };

    if (request.method === 'OPTIONS') {
      return new Response(null, { headers: corsHeaders });
    }

    // 1. Live Smartcar OAuth Redirect Route
    if (url.pathname === '/api/auth' || url.pathname === '/auth') {
      const scope = 'read_vehicle_info read_diagnostics control_security';
      const authUrl = `https://connect.smartcar.com/oauth/authorize?response_type=code&client_id=${CLIENT_ID}&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&scope=${encodeURIComponent(scope)}&mode=live`;
      
      return Response.redirect(authUrl, 302);
    }

    // 2. Auth Callback Route
    if (url.pathname === '/auth/callback') {
      const code = url.searchParams.get('code');
      if (code) {
        return new Response(`
          <html>
            <body style="background:#0b132b;color:#fff;font-family:sans-serif;text-align:center;padding:40px;">
              <h2>✅ Vehicle Authorized Successfully!</h2>
              <p>Authorization Code Received. You can now return to the app.</p>
              <a href="https://ct-gifted1.github.io" style="color:#00d2ff;font-weight:bold;">Return to Garage Agent App</a>
            </body>
          </html>
        `, { headers: { 'Content-Type': 'text/html' } });
      }
      return new Response("Authorization failed or no code provided.", { status: 400 });
    }

    // 3. Fallback for Diagnostic API requests
    return new Response(JSON.stringify({
      status: "online",
      message: "Garage Agent Worker Live"
    }), {
      headers: { ...corsHeaders, 'Content-Type': 'application/json' }
    });
  }
};
